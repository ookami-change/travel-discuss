# Postgres
DATABASE_URL=postgres://localhost:5432/travel_discuss

# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# 高德开放平台「Web 服务」Key — used server-side for place search
AMAP_WEB_SERVICE_KEY=

# Any OpenAI-compatible chat API. DeepSeek:
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 通义千问 instead: AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
AI_API_KEY=

# S3-compatible object storage. 腾讯云 COS example:
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_REGION=ap-guangzhou
S3_BUCKET=travel-1250000000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
